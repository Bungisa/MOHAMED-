{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:web": "vite build",
    "build:cap": "node scripts/build-android.mjs web",
    "cap:sync": "npm run build:cap && npx cap sync && node scripts/setup-android-open-with.mjs",
    "cap:add:android": "npx cap add android && node scripts/setup-android-open-with.mjs",
    "cap:android:open-with": "node scripts/setup-android-open-with.mjs",
    "android:init": "node scripts/build-android.mjs init",
    "android:build:debug": "node scripts/build-android.mjs debug",
    "android:build:apk": "node scripts/build-android.mjs apk",
    "android:build:aab": "node scripts/build-android.mjs aab",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync && npx cap run android",
    "cap:run:ios": "npm run cap:sync && npx cap run ios",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "docx": "^9.15.3",
    "docx-preview": "^0.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "idb": "^8.0.4",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^8.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0 || ^0.27.0 || ^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
