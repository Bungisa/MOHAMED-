# Optional CLI release signing config for `./gradlew bundleRelease` or `./gradlew assembleRelease`.
# Copy this file to `android/keystore.properties` (which is gitignored) and fill in your keystore details.
# Or sign directly inside Android Studio via: Build -> Generate Signed App Bundle / APK.
storeFile=elimikapdf-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=elimikapdf
keyPassword=YOUR_KEY_PASSWORD
